<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>510d6fa8-9c86-45e3-9adc-94ceeaefabf2</UserSecretsId>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591 (missing XML comment) is only enforced where we've chosen to document; not every
         public member project-wide needs a doc comment for the compiler to complain about. -->
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets BiatecMCPTests unit-test a handful of internal, no-network-I/O helpers directly (e.g.
         GetAlgodSettings' explorer-URL resolution) without needing a live algod node - same "seam for
         testability" precedent as this project's other IPublicXDataSource interfaces. -->
    <InternalsVisibleTo Include="BiatecMCPTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Algorand5: transaction construction/encoding and Algod broadcast only - no key material ever
         touches this project (see MCP/BiatecMCP.cs's class remarks). Microsoft.AspNetCore.Authentication.JwtBearer
         + ModelContextProtocol.AspNetCore: OAuth 2.1 resource-server wiring delegating to BiatecOIDC -
         see Program.cs. Deliberately no Google.Apis.*/Microsoft.Extensions.Caching.StackExchangeRedis/
         Swashbuckle.AspNetCore packages (or a BiatecSelfCustodyCore project reference) - this service no
         longer does its own identity/storage-provider sign-in, session pairing, or Swagger UI. -->
    <!-- NOTE: Directory.Build.props also injects an Algorand4 reference with ExcludeAssets="all" so BiatecRouterConnector
         (still depends on Algorand4) cannot put Algorand4's Algorand.dll in the output ahead of Algorand5. See that file. -->
    <PackageReference Include="Algorand5" Version="5.0.2.2026101113" />
    <PackageReference Include="BiatecRouterConnector" Version="1.0.3.2026080111" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <PackageReference Include="NBitcoin" Version="10.0.17" />
    <PackageReference Include="NBitcoin.Altcoins" Version="6.0.11" />
  </ItemGroup>

</Project>
