{
  "Cors": {
    "AllowedOrigins": ["https://google.biatec.io", "https://oidc.biatec.io"]
  },
  "App": {
    "Host": "https://google.biatec.io",
    "StorageFolderName": "Biatec",
    "StorageFileName": "AVMAccount.%AESID%.dat",
    "ApplicationName": "Biatec"
  },
  "AesOptions": { //actually loeded from the secret - see generate-stage-secret.sh's shape for the real env vars
    "ActiveKeyId": "placeholder",
    "Keys": [
      {
        "KeyId": "placeholder",
        "Key": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=",
        "IV": "AAAAAAAAAAAAAAAAAAAAAA=="
      }
    ]
  },
  "ProviderTokenProtection": { //actually loeded from the secret - see generate-stage-secret.sh's shape for the real env vars
    "ActiveKeyId": "placeholder",
    "Keys": [
      {
        "KeyId": "placeholder",
        "Key": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=",
        "IV": "AAAAAAAAAAAAAAAAAAAAAA=="
      }
    ]
  },
  "CloudServices": {
    "Google": {
      "ClientId": "ClientId", //actually loeded from the secret
      "ClientSecret": "ClientSecret" //actually loeded from the secret
    },
    "Entra": {
      "TenantId": "common",
      "ClientId": "ClientId", //actually loeded from the secret
      "ClientSecret": "ClientSecret" //actually loeded from the secret
    }
  },
  "Redis": {
    "ConnectionString": "localhost:6379" //actually loeded from the secret
  },
  // JwtIssuer:* (including Clients and ProtectedResources) lives entirely in google-account-main-app-secret,
  // not this ConfigMap - see k8s/stage/conf-oidc-stage/appsettings.json for the shape it must take.
  // Required for BiatecMCP (see k8s/main/deployment-mcp.yaml's biatec-mcp-domain-ingress):
  // JwtIssuer__ProtectedResources__0=https://mcp.biatec.io/mcp
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
