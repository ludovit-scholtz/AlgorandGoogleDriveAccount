<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>e6b8f6a1-6d5b-4a6b-9c0f-6a2ac2f9f6b1</UserSecretsId>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591 (missing XML comment) is only enforced where we've chosen to document; not every
         public member project-wide needs a doc comment for the compiler to complain about. -->
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Algorand5" Version="5.0.3.2026101923" />
    <!-- Client for the Biatec Router API (router.api.biatec.io) - used only for its public, unauthenticated
         /quote endpoint (BiatecRouterValuationService) to price a spent asset in USD for spending-limit
         enforcement. Not used for its swap/route-transaction-building features. -->
    <PackageReference Include="BiatecRouterConnector" Version="1.0.15.2026101920" />
    <PackageReference Include="Google.Apis.Auth" Version="1.77.0" />
    <PackageReference Include="Google.Apis.Auth.AspNetCore3" Version="1.77.0" />
    <!-- MessagePack is used directly by AlgorandTransactionInspector (generic msgpack map decode); its version comes from the
         repo-wide security override in Directory.Build.props, not a PackageReference here. -->
    <!-- Used directly by AlgorandTransactionInspector (generic msgpack map decode); otherwise only a transitive dependency of
         Algorand5. Keep >= 3.1.12 (3.1.8 carries advisory GHSA-qhrr-8q5h-9q3h). -->
    <PackageReference Include="MessagePack" Version="3.1.12" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.13" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BiatecSelfCustodyCore\BiatecSelfCustodyCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copied to the publish/output directory so Program.cs can load it at runtime as Swagger UI's
         top-of-page documentation (OpenApiInfo.Description) - see the AddSwaggerGen call. -->
    <Content Include="OIDC_INTEGRATION_GUIDE.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
