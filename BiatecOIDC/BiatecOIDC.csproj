<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>e6b8f6a1-6d5b-4a6b-9c0f-6a2ac2f9f6b1</UserSecretsId>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591 (missing XML comment) is only enforced where we've chosen to document; not every
         public member project-wide needs a doc comment for the compiler to complain about. -->
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Algorand4" Version="4.7.4.2026071920" />
    <!-- Client for the Biatec Router API (router.api.biatec.io) - used only for its public, unauthenticated
         /quote endpoint (BiatecRouterValuationService) to price a spent asset in USD for spending-limit
         enforcement. Not used for its swap/route-transaction-building features. -->
    <PackageReference Include="BiatecRouterConnector" Version="1.0.0.2026011820" />
    <PackageReference Include="Google.Apis.Auth" Version="1.75.0" />
    <PackageReference Include="Google.Apis.Auth.AspNetCore3" Version="1.75.0" />
    <!-- Direct reference for AlgorandTransactionInspector's generic msgpack map decode (peeking the
         "type" discriminator before picking the correctly-typed Transaction subclass) - otherwise only
         a transitive dependency of Algorand4. Version pinned to match what Algorand4 already resolves. -->
    <PackageReference Include="MessagePack" Version="3.1.8" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.10" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.21.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BiatecSelfCustodyCore\BiatecSelfCustodyCore.csproj" />
  </ItemGroup>

</Project>
