<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591 (missing XML comment) is only enforced where we've chosen to document; not every
         public member project-wide needs a doc comment for the compiler to complain about. -->
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Algorand4" Version="4.7.4.2026071920" />
    <!-- Successor to the retired AlgorandARC76Account package - split per chain family (this repo only
         needs the Algorand and Ethereum derivations; ARC76Account.Core is a shared transitive dependency
         of both, never referenced directly here). -->
    <PackageReference Include="ARC76Account.Algorand" Version="1.0.1.2026080317" />
    <PackageReference Include="ARC76Account.Ethereum" Version="1.0.1.2026080317" />
    <PackageReference Include="Google.Apis.Auth" Version="1.75.0" />
    <PackageReference Include="Google.Apis.Auth.AspNetCore3" Version="1.75.0" />
    <PackageReference Include="Google.Apis.Drive.v3" Version="1.75.0.4210" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.10" />
    <!-- Explicit overrides: Google.Apis.Auth(.AspNetCore3) 1.75.0 transitively pulls in the
         Microsoft.IdentityModel.* / System.IdentityModel.Tokens.Jwt 5.5.0 release train, which carries a
         known moderate-severity advisory (GHSA-59j7-ghrg-fj52 - see audit finding M-02/R-022). Pinned here
         to the same patched version BiatecOIDC.csproj already uses directly, so the vulnerable transitive
         version is never actually resolved into the dependency graph. -->
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.21.0" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.21.0" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.21.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.21.0" />
  </ItemGroup>

</Project>
